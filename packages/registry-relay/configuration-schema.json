{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "relay_base_url": {
      "title": "Registry Relay URL",
      "type": "string",
      "description": "Legacy Relay service base URL.",
      "format": "uri",
      "minLength": 1,
      "examples": [
        "https://relay.example.gov"
      ]
    },
    "token": {
      "title": "Bearer Token",
      "type": "string",
      "description": "Legacy static bearer token.",
      "writeOnly": true,
      "minLength": 1
    },
    "relay_token": {
      "title": "Legacy Bearer Token Alias",
      "type": "string",
      "description": "Legacy alias for the static bearer token.",
      "writeOnly": true,
      "minLength": 1
    },
    "relay": {
      "title": "Registry Relay Client Configuration",
      "description": "Native Registry Stack client configuration. Credentials remain in OpenFn configuration.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseUrl",
        "authorization"
      ],
      "properties": {
        "baseUrl": {
          "type": "string",
          "description": "Relay deployment URL, including any reverse-proxy prefix.",
          "format": "uri",
          "minLength": 1
        },
        "authorization": {
          "writeOnly": true,
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "static"
              ],
              "properties": {
                "static": {
                  "type": "string",
                  "description": "Bearer token without the Bearer prefix.",
                  "format": "password",
                  "minLength": 1,
                  "writeOnly": true
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "privateKeyJwt"
              ],
              "properties": {
                "privateKeyJwt": {
                  "type": "object",
                  "description": "Registry Stack private-key JWT token client configuration.",
                  "writeOnly": true
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "exchange"
              ],
              "properties": {
                "exchange": {
                  "type": "object",
                  "description": "Registry Stack token-exchange authorization configuration.",
                  "writeOnly": true
                }
              }
            }
          ]
        },
        "requestTimeoutMilliseconds": {
          "type": "integer",
          "minimum": 1
        },
        "connectTimeoutMilliseconds": {
          "type": "integer",
          "minimum": 1
        },
        "maximumResponseBytes": {
          "type": "integer",
          "minimum": 1
        },
        "userAgent": {
          "type": "string"
        },
        "trustedRootCertificates": {
          "type": "string",
          "description": "PEM trust roots for the Relay HTTPS connection."
        }
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "relay"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "relay_base_url"
            ]
          },
          {
            "required": [
              "token"
            ]
          },
          {
            "required": [
              "relay_token"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "relay_base_url"
      ],
      "anyOf": [
        {
          "required": [
            "token"
          ]
        },
        {
          "required": [
            "relay_token"
          ]
        }
      ],
      "not": {
        "required": [
          "relay"
        ]
      }
    }
  ]
}
